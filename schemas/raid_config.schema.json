{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raid_config.schema.json",
  "title": "当周战斗配置",
  "type": "object",
  "required": [
    "date",
    "timezone",
    "combat_log",
    "raw_combat_log",
    "custom_data",
    "raid_start",
    "raid_end",
    "zone_names",
    "logger_identity"
  ],
  "properties": {
    "schema_version": { "type": "integer" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "timezone": { "type": "string", "pattern": "^[+-]\\d{2}:\\d{2}$" },
    "combat_log": { "type": "string" },
    "raw_combat_log": { "type": "string" },
    "custom_data": { "type": "string" },
    "raid_start": { "type": "string" },
    "raid_end": { "type": "string" },
    "zone_names": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "logger_identity": {
      "type": "object",
      "required": ["guid", "name"],
      "properties": {
        "guid": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "roster_overrides": { "type": "array" },
    "encounters": { "type": "array" },
    "raid_groups": { "type": "object" },
    "class_overrides": { "type": "object" },
    "role_overrides": { "type": "object" },
    "curse_assignments": { "type": "object" },
    "declared_inputs": { "type": "object" },
    "input_notes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
