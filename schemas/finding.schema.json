{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "分析结论",
  "type": "object",
  "required": [
    "finding_id",
    "rule_id",
    "status",
    "weight",
    "values",
    "window",
    "evidence",
    "confidence",
    "assumptions"
  ],
  "properties": {
    "finding_id": { "type": "string" },
    "rule_id": { "type": "string" },
    "player": { "type": ["string", "null"] },
    "target": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "weight": { "type": "number" },
    "values": { "type": "object" },
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" }
      }
    },
    "evidence": { "type": "array", "minItems": 1 },
    "confidence": { "enum": ["high", "medium", "low"] },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  }
}
